VITE_API_BASE_URL=http://localhost:3000

# Local development only. A production build IGNORES both of these — the
# branch that reads them is compiled out (see src/lib/familyKey.ts), so a
# deployed bundle cannot contain the key even if these are set at build
# time. A real screen is linked once, on the device, and the key is kept in
# that device's localStorage.
#
# Both come from POST /families (see backend/README.md's Authentication).
VITE_FAMILY_ID=
VITE_FAMILY_API_KEY=
