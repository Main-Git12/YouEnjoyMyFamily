VITE_API_BASE_URL=http://localhost:3000
# The family's API key, issued once by POST /families (see backend/README.md).
# This build is a fixed Echo Show/kiosk display for one family, not a public
# multi-user site, so the key is baked in at build/deploy time rather than
# collected from a per-visitor login.
VITE_FAMILY_API_KEY=
